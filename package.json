{
  "name": "creation-workshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait mysql && concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm run server:dev\"",
    "dev:app": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm run server:dev\"",
    "dev:web": "vite",
    "dev:db": "docker compose up -d --wait mysql",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "cd server && npm run dev",
    "server:test": "cd server && npm run test"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "^2.38.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^10.0.3",
    "jsdom": "^26.1.0",
    "sass": "^1.72.0",
    "vite": "^5.2.0",
    "vitest": "^3.2.4"
  }
}
