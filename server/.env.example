PORT=4398
# 宿主机 dev 模式连 docker 映射的 localhost:3306；
# 若用 docker compose 跑 backend 容器，docker-compose.yml 的 environment 会覆盖为 mysql（docker 网络 DNS）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_chat_draw
MYSQL_USER=root
MYSQL_PASSWORD=root
# 真实 key 请写在 server/.env（被 .gitignore 忽略），切勿填入此模板文件
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
